### THREDDS related environment variables

# TDS Content root

TDS_CONTENT_ROOT_PATH=/usr/local/tomcat/content

# TDM authentication. Set TDM_PW to the password of a TDS user that has only
# the tdsTrigger role. Do not commit the password to version control.

TDM_PW=

# Use HTTPS so the TDM credential is encrypted in transit.
TDS_HOST=https://tds.example.test/

# The minimum and maximum Java heap space memory to be allocated to the TDM

TDM_XMX_SIZE=6G

TDM_XMS_SIZE=1G

# Set to your liking
TDM_USER_ID=1000

TDM_GROUP_ID=1000
